{
    "name": "@nivinjoseph/n-strument",
    "version": "2.0.2",
    "description": "Instrumentation helper library",
    "type": "module",
    "exports": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "packageManager": "yarn@4.16.0",
    "scripts": {
        "ts-compile": "tsc -p .",
        "ts-lint": "eslint . --ext .ts",
        "ts-build": "yarn ts-compile && yarn ts-lint",
        "ts-build-dist": "yarn ts-build && tsc -p ./dist",
        "clean-src": "find ./src -name '*.js' -delete -o -name '*.map' -delete",
        "clean-test": "find ./test -name '*.js' -delete -o -name '*.map' -delete",
        "test": "yarn clean-test && yarn ts-build && node --test --enable-source-maps './test/**.test.js'",
        "publish-package": "yarn ts-build-dist && git add . && git commit -m 'preparing to publish new version' && yarn version patch && git add . && git commit -m 'new version' && git push && npm publish --access=public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nivinjoseph/n-strument.git"
    },
    "keywords": [
        "instrumentation",
        "observability",
        "otel"
    ],
    "author": "NiviN",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/nivinjoseph/n-strument/issues"
    },
    "homepage": "https://github.com/nivinjoseph/n-strument#readme",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "24.10",
        "@typescript-eslint/parser": "8.58.2",
        "eslint": "10.2.1",
        "eslint-import-resolver-typescript": "4.4.4",
        "eslint-plugin-import": "2.32.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.58.2"
    },
    "dependencies": {
        "@nivinjoseph/n-config": "2.0.5",
        "@nivinjoseph/n-util": "4.0.2",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/auto-instrumentations-node": "0.83.1",
        "@opentelemetry/context-async-hooks": "3.1.1",
        "@opentelemetry/core": "3.1.1",
        "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
        "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
        "@opentelemetry/id-generator-aws-xray": "3.0.1",
        "@opentelemetry/instrumentation": "0.301.2",
        "@opentelemetry/instrumentation-koa": "0.73.0",
        "@opentelemetry/propagator-aws-xray": "3.0.0",
        "@opentelemetry/resources": "3.1.1",
        "@opentelemetry/sdk-metrics": "3.1.1",
        "@opentelemetry/sdk-trace": "3.1.1",
        "@opentelemetry/semantic-conventions": "1.45.0",
        "tslib": "2.8.1"
    },
    "engines": {
        "node": ">=24.10"
    }
}
